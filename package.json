{
  "name": "battered-batteries-func",
  "version": "1.0.0",
  "description": "Consumes the setpoints and sends them to battered batteries",
  "main": "dist/functions/*.js",
  "private": true,
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@azure/functions": "^4.0.0",
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "rimraf": "^5.0.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
